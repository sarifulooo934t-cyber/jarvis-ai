# ---------- security ----------
# Lamba random token banao:  python -c "import secrets;print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=change-me-to-a-long-random-string

# ---------- AI provider ----------
# gemini | groq | openrouter | openai | ollama | anthropic
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
LLM_API_KEY=
# Khaali chhodo to provider ka default model chalega
LLM_MODEL=gemini-2.5-flash
# Sirf custom OpenAI-compatible endpoint ke liye
LLM_BASE_URL=

# ---------- browser control ----------
# Server par 1 (headless), apne laptop par 0 (dikhega)
BROWSER_HEADLESS=1
